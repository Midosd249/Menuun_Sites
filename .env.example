# Public Supabase project configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add service-role or secret keys to NEXT_PUBLIC_* variables.
# Configure real values in your local .env.local or hosting environment, not here.

# Canonical public origin for salon URLs (never a per-preview deployment URL).
MENUUN_PUBLIC_ORIGIN=https://menuun-sites.vercel.app
